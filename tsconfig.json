{
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "dist",
    "sourceMap": false,
    "outDir": "dist",
    "emitDeclarationOnly": true,
    "allowJs": true,
    "strict": true,
    "module": "esnext",
    "target": "es2020",
    "importHelpers": true,
    "noEmitHelpers": true,
    "lib": [
      "DOM",
      "ES2020"
    ],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@src": [
        "src"
      ],
      "@src/*": [
        "src/*"
      ],
      "@types": [
        "src/types"
      ],
      "@types/*": [
        "src/types/*"
      ],
      "@tests": [
        "tests"
      ],
      "@tests/*": [
        "tests/*"
      ],
      "@stories": [
        "stories"
      ],
      "@stories/*": [
        "stories/*"
      ]
    }
  },
  "include": [
    "src",
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "stories",
    "**/*.stories.tsx",
    "**/*.test.tsx",
    ".old",
    ".storybook"
  ]
}